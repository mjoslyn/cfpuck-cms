<!-- DEVELOPERS -->
<section id="developers" style="background: #1B2A6B; color: #F7F0F5; padding: 104px 0 112px">
<div class="mp-wrap" style="display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start">
<div style="flex: 1 1 420px; min-width: 0">
<p class="mp-label" style="margin: 0 0 18px; color: #FFA5FF">Under the hood</p>
<h2 class="mp-serif mp-h2" style="margin: 0; font-size: 68px; line-height: 1">One Worker, your own database, no servers</h2>
<p style="margin: 22px 0 28px; font-size: 19px; line-height: 1.55; color: #DCD8FF">Moonpuck is Astro on a Cloudflare Worker, with content in D1 and files in R2. Each site is its own repository: your blocks, styles and types live in one folder, and core updates merge in with git.</p>
<div style="display: flex; flex-wrap: wrap; gap: 8px">
<span style="border: 1.5px solid #DCD8FF; border-radius: 999px; padding: 6px 14px; font-size: 14px">Pages cached at the edge</span>
<span style="border: 1.5px solid #DCD8FF; border-radius: 999px; padding: 6px 14px; font-size: 14px">Keys kept encrypted</span>
<span style="border: 1.5px solid #DCD8FF; border-radius: 999px; padding: 6px 14px; font-size: 14px">Blocks you write yourself</span>
</div>
</div>
<pre style="flex: 1 1 480px; min-width: 0; margin: 0; background: #0F1840; border: 3px solid #120C1F; border-radius: 18px; color: #DCD8FF; padding: 28px; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 14px; line-height: 1.8; overflow-x: auto"><span style="color: #9898FF"># your site, beside the core</span>
src/site/
  config.ts      <span style="color: #9898FF">types, taxonomies, fields</span>
  render.ts      <span style="color: #9898FF">blocks, cards, head</span>
  editor.tsx     <span style="color: #9898FF">panels, settings</span>
  styles/tokens.css

<span style="color: #9898FF"># take core updates</span>
<span style="color: #FDF152">git fetch upstream &amp;&amp; git merge upstream/main</span>
<span style="color: #FDF152">npm run deploy</span></pre>
</div>
</section>

