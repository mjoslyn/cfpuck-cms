PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The database itself (the query layer, src/lib/db): locally the stack's DB URL; hosted, the project's
# transaction pooler (port 6543). DATABASE_POOL_MAX: connections per server instance (default 5).
DATABASE_URL=
DATABASE_POOL_MAX=

# Files (src/lib/storage.ts): one private bucket on an S3-compatible store. Production: Cloudflare R2
# (endpoint https://<account-id>.r2.cloudflarestorage.com, region auto, an API token's access key and
# secret). Locally: the Supabase stack's S3 endpoint and its `site` bucket (supabase/config.toml), with
# the S3 access key and secret `npx supabase status` prints.
STORAGE_ENDPOINT=http://127.0.0.1:56521/storage/v1/s3
STORAGE_BUCKET=site
STORAGE_REGION=local
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Accounts (src/lib/auth): AUTH_SECRET signs sessions and the site's links; a long random value of its
# own (openssl rand -hex 32). Changing it signs everyone out and breaks links already sent.
# AUTH_CONFIRM_EMAIL=false lets member sign-ups in without confirming their address (default: they
# confirm by email first).
AUTH_SECRET=
AUTH_CONFIRM_EMAIL=

# Outgoing mail (form notifications) over SMTP: any provider. Either host settings or one SMTP_URL
# (smtp://user:pass@host:587; locally the Supabase stack's mail catcher, smtp://127.0.0.1:56525). Without either, submissions are
# stored and no mail is sent. SMTP_SECURE defaults to true on port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_URL=
MAIL_FROM="Site name <noreply@example.com>"
FORMS_ADMIN_EMAIL=info@example.org

# Payments, for forms (a form's Payment tab) and tickets (Settings > Tickets); free tickets need none.
# Stripe: a secret key (sk_test_... to test), and the signing secret of one webhook endpoint at
# <site>/api/payments/stripe (checkout.session.*, charge.refunded and charge.refund.updated events).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Square: an access token and location id; SQUARE_ENVIRONMENT=sandbox to test (default production;
# sandbox links open Square's testing panel, where Test Payment pays).
# Webhook: one subscription at <site>/api/payments/square (payment.created, payment.updated,
# refund.created, refund.updated), its signature key, and that exact address (the signature covers it).
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
# Where the copy of each ticket order goes (default FORMS_ADMIN_EMAIL, then the config's adminEmail).
TICKETS_NOTIFY_EMAIL=
# The site's address for links in ticket emails (default Netlify's URL).
SITE_URL=

# Mailing (Settings > Mailing Lists): campaigns and the weekly digest through Mailgun, from a marketing
# subdomain (MAILGUN_DOMAIN, e.g. news.example.org). MAILGUN_REGION=eu for EU accounts. The webhook at
# <site>/api/mailgun/webhook (delivered, opened, failed, complained, unsubscribed) is checked with its
# signing key. MAILGUN_TEST_MODE=true: Mailgun accepts and delivers nothing. Without the key and domain,
# campaigns go to a mail catcher on this machine (SMTP to 127.0.0.1), else are only logged.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_TEST_MODE=
# The key for the signed links in mailing emails (unsubscribe, preferences, confirmation, tracked
# links). Any long random string; changing it breaks links already sent. Default: one made from the
# service key.
MAIL_LINK_SECRET=

# Compose with Claude (/admin/compose/ and the editor's Compose button).
ANTHROPIC_API_KEY=
# Optional model override (default claude-sonnet-5-5).
ANTHROPIC_MODEL=

# The local admin the e2e scripts sign in as (scripts/*-e2e.ts)
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
# The local mail catcher's web address (its inbox), for scripts/notification-e2e.ts.
LOCAL_MAIL_URL=http://127.0.0.1:56524

# Sync with another copy of this site (Settings > Sync), from this copy: its name, Supabase URL and
# service_role key. Leave empty on a copy that only receives syncs.
SYNC_REMOTE_NAME=
SYNC_REMOTE_URL=
SYNC_REMOTE_SERVICE_KEY=
# Its store, as STORAGE_* above (without these, its Supabase Storage).
SYNC_REMOTE_STORAGE_ENDPOINT=
SYNC_REMOTE_STORAGE_BUCKET=
SYNC_REMOTE_STORAGE_REGION=
SYNC_REMOTE_STORAGE_ACCESS_KEY_ID=
SYNC_REMOTE_STORAGE_SECRET_ACCESS_KEY=
