# The database is D1 (wrangler.jsonc, schema in db/migrations): astro dev and scripts use the local one
# in .wrangler/state. Scripts reach the deployed one with these (an API token with D1 edit); leave them
# empty to work locally. D1_LOCAL_FILE: the local file, if there are several.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
D1_LOCAL_FILE=
# Only for moving a site off Postgres (scripts/pg-to-d1.ts): the database to copy from.
DATABASE_URL=

# Files (src/lib/storage.ts): the R2 bucket bound as BUCKET (wrangler.jsonc); astro dev and scripts use
# a local one in .wrangler/state. Leave these empty, except for scripts working on the deployed bucket
# (R2's S3 API: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto, an R2 API token's
# access key and secret). Set, they win in the Worker too (any S3-compatible store).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Only for moving a site's files (scripts/copy-storage.ts): the store to copy from.
SOURCE_STORAGE_ENDPOINT=
SOURCE_STORAGE_BUCKET=
SOURCE_STORAGE_REGION=
SOURCE_STORAGE_ACCESS_KEY_ID=
SOURCE_STORAGE_SECRET_ACCESS_KEY=

# Accounts (src/lib/auth): AUTH_SECRET signs sessions and the site's links; a long random value of its
# own (openssl rand -hex 32). Changing it signs everyone out and breaks links already sent.
# AUTH_CONFIRM_EMAIL=false lets member sign-ups in without confirming their address (default: they
# confirm by email first).
AUTH_SECRET=
AUTH_CONFIRM_EMAIL=

# Outgoing mail (form notifications) over SMTP: any provider. Either host settings or one SMTP_URL
# (smtp://user:pass@host:587; locally a mail catcher such as Mailpit, smtp://127.0.0.1:1025). Without either, submissions are
# stored and no mail is sent. SMTP_SECURE defaults to true on port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_URL=
MAIL_FROM="Site name <noreply@example.com>"
FORMS_ADMIN_EMAIL=info@example.org

# Payments, for forms (a form's Payment tab) and tickets (Settings > Tickets); free tickets need none.
# Stripe: a secret key (sk_test_... to test), and the signing secret of one webhook endpoint at
# <site>/api/payments/stripe (checkout.session.*, charge.refunded and charge.refund.updated events).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Square: an access token and location id; SQUARE_ENVIRONMENT=sandbox to test (default production;
# sandbox links open Square's testing panel, where Test Payment pays).
# Webhook: one subscription at <site>/api/payments/square (payment.created, payment.updated,
# refund.created, refund.updated), its signature key, and that exact address (the signature covers it).
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
# Where the copy of each ticket order goes (default FORMS_ADMIN_EMAIL, then the config's adminEmail).
TICKETS_NOTIFY_EMAIL=
# The site's address for links in emails (default the request's address; Mailing's campaigns and digests
# need it, since they are made without a request).
SITE_URL=
# The help button in the admin bar (default the core's site guide on GitHub Pages).
HELP_URL=

# Mailing (Settings > Mailing Lists): campaigns and the weekly digest through Mailgun, from a marketing
# subdomain (MAILGUN_DOMAIN, e.g. news.example.org). MAILGUN_REGION=eu for EU accounts. The webhook at
# <site>/api/mailgun/webhook (delivered, opened, failed, complained, unsubscribed) is checked with its
# signing key. MAILGUN_TEST_MODE=true: Mailgun accepts and delivers nothing. Without the key and domain,
# campaigns go to a mail catcher on this machine (SMTP to 127.0.0.1), else are only logged.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_TEST_MODE=
# The key for the signed links in mailing emails (unsubscribe, preferences, confirmation, tracked
# links). Any long random string; changing it breaks links already sent. Default: one made from
# AUTH_SECRET. A site that moved off Supabase without one: mail-links:<its old service_role key>.
MAIL_LINK_SECRET=

# Compose with Claude (/admin/compose/ and the editor's Compose button). Or connect it under
# Settings > Connections (as Stripe, Square and Mailgun can be); a key here wins.
ANTHROPIC_API_KEY=
# Optional model override (default claude-sonnet-5-5).
ANTHROPIC_MODEL=

# The local admin the e2e scripts sign in as (scripts/*-e2e.ts)
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
# The local mail catcher's web address (Mailpit's inbox and API), for the e2e scripts that read email.
LOCAL_MAIL_URL=http://127.0.0.1:8025

# Sync with another copy of this site (Settings > Sync). SYNC_SECRET: the same long random value
# (32 characters or more) on both copies; a copy without it can't be synced with. On the copy that starts
# syncs: the other's name and address. Leave those empty on a copy that only receives syncs.
SYNC_SECRET=
SYNC_REMOTE_NAME=
SYNC_REMOTE_URL=

# 1 (or true) on a copy search engines should leave alone (a demo, or a preview on its own domain): every
# answer, static files included, carries X-Robots-Tag: noindex. On the Worker, a variable in wrangler.jsonc
# vars (the build reads it there for static files); after changing it, clear the page cache (any admin
# save does).
SITE_NOINDEX=
