---
// Content > Taxonomies: a tab per taxonomy of the site's config, its terms nested under their parents,
// each with its name, address and template to change, how many entries use it, its page, Details
// (description, featured image, fields, SEO: src/admin/TermDetails.tsx) and Delete;
// a form to add one (and where it goes), and a template for the terms ticked. A term moves by dragging
// its handle: onto the top or bottom edge of another term to go beside it (the order at that level),
// onto its middle to go under it, or onto Top level; with the keyboard, the handle's menu moves it up,
// down or under another term. Saves through /api/admin/terms.
import { site } from '../lib/site';
import { termLink } from '../lib/permalink';
import { TAXONOMY_BASES } from '../lib/site';
import { termPagesOn, termTemplate, templateLabel } from '../lib/templates';
import TermDetails from './TermDetails';
import { showsTaxonomy, type Features } from '../lib/features';

interface Props {
  taxonomy: string;
  /** Which features are on (Settings > Events, Shop): their taxonomies are hidden while off. */
  features: Features;
  error?: string | null;
  notice?: string | null;
}
const { taxonomy, features, error, notice } = Astro.props;
const taxonomies = site.taxonomies.filter((t) => showsTaxonomy(t.name, features));
const db = Astro.locals.db;
const tax = taxonomies.find((t) => t.name === taxonomy) ?? taxonomies[0];
const flat = tax.name === 'tag';
const one = (tax.singular ?? tax.label).toLowerCase();

const { data, error: readErr } = await db.from('terms').select('id, name, slug, parent_id, fields, sort, entry_terms(count)').eq('taxonomy', tax.name).order('sort').order('name');
if (readErr) throw readErr;
const terms = (data ?? []).map((t: any) => ({ id: t.id as number, name: t.name as string, slug: t.slug as string, parent: (t.parent_id as number | null) ?? 0, count: (t.entry_terms?.[0]?.count ?? 0) as number, template: (t.fields?.template as string | undefined) ?? '' }));
const byId = new Map((data ?? []).map((t: any) => [t.id as number, { parent_id: t.parent_id as number | null, fields: t.fields }]));
const { data: tpls } = await db.from('templates').select('slug, title').eq('kind', 'template').is('trashed_at', null).order('slug');
const templates = (tpls ?? []) as { slug: string; title: string }[];
const { data: siteRow } = await db.from('settings').select('value').eq('key', 'site').maybeSingle();
// Term pages exist (a URL base) and are on (Settings > Types).
const pages = !!TAXONOMY_BASES[tax.name] && termPagesOn(siteRow?.value as Record<string, any> | undefined, tax.name);
/** What a term without its own template shows: a template from a term above it, else the taxonomy's. */
const inherited = (id: number) => {
  const t = byId.get(id);
  const up = t?.parent_id ? termTemplate(byId.get(t.parent_id)!, byId) : null;
  return up ? `From ${decode(terms.find((x) => x.id === (up.from ?? t!.parent_id))?.name ?? 'above')}: ${up.slug}` : `The taxonomy's`;
};
const decode = (s: string) => s.replace(/&#8217;/g, '’').replace(/&#038;|&amp;/g, '&').replace(/&#8211;/g, '–');

// Nested order: each term under its parent (orphans, whose parent is gone, at the top level).
const ids = new Set(terms.map((t) => t.id));
const childrenOf = (p: number) => terms.filter((t) => (ids.has(t.parent) ? t.parent : 0) === p);
const ordered: (typeof terms[number] & { depth: number })[] = [];
const place = (p: number, depth: number) => childrenOf(p).forEach((t) => (ordered.push({ ...t, depth }), place(t.id, depth + 1)));
place(0, 0);
// The terms a term may sit under: any but itself and the terms under it.
const under = (id: number): Set<number> => {
  const out = new Set([id]);
  for (let grew = true; grew; ) {
    grew = false;
    for (const t of terms) if (out.has(t.parent) && !out.has(t.id)) (out.add(t.id), (grew = true));
  }
  return out;
};
const counts = new Map<string, number>();
await Promise.all(taxonomies.map(async (t) => {
  const { count } = await db.from('terms').select('id', { count: 'exact', head: true }).eq('taxonomy', t.name);
  counts.set(t.name, count ?? 0);
}));
const input = 'rounded border border-admin-ink/15 bg-white px-2 py-1 text-sm focus:border-admin-accent focus:outline-none';
---
<nav class="mt-4 flex flex-wrap gap-1 border-b border-admin-ink/10 text-sm" aria-label="Taxonomies">
  {taxonomies.map((t) => (
    <a href={`/admin/?type=terms&taxonomy=${t.name}`} aria-current={t.name === tax.name ? 'page' : undefined} class:list={['-mb-px border-b-2 px-3 py-2', t.name === tax.name ? 'border-admin-accent text-admin-ink' : 'border-transparent text-admin-muted hover:text-admin-ink']}>
      {t.label} <span class="text-xs text-admin-muted">({counts.get(t.name)})</span>
    </a>
  ))}
</nav>

{error && <p class="mt-4 rounded bg-[#c4592a]/10 px-3 py-2 text-sm text-[#a3441c]" role="alert">{error}</p>}
{notice && <p class="mt-4 rounded bg-[#6db56d]/10 px-3 py-2 text-sm text-admin-ink" role="status">{notice}</p>}

<form method="post" action="/api/admin/terms" class="mt-4 flex flex-wrap items-end gap-2 text-sm">
  <input type="hidden" name="taxonomy" value={tax.name} />
  <input type="hidden" name="action" value="create" />
  <label class="text-xs text-admin-muted">Name<input name="name" required class={`${input} mt-1 block w-56`} /></label>
  <label class="text-xs text-admin-muted">Address (optional)<input name="slug" placeholder="from the name" class={`${input} mt-1 block w-44`} /></label>
  {!flat && (
    <label class="text-xs text-admin-muted">Under
      <select name="parent" class={`${input} mt-1 block w-56`}>
        <option value="">(top level)</option>
        {ordered.map((t) => <option value={t.id}>{'  '.repeat(t.depth)}{decode(t.name)}</option>)}
      </select>
    </label>
  )}
  <button class="rounded-sm bg-admin-ink px-4 py-2 text-xs font-semibold tracking-wider text-white uppercase hover:bg-admin-accent">Add {one}</button>
</form>

{pages && (
  <form id="bulk-template" method="post" action="/api/admin/terms" class="mt-6 flex flex-wrap items-center gap-2 text-sm">
    <input type="hidden" name="taxonomy" value={tax.name} />
    <input type="hidden" name="action" value="template" />
    <label class="text-xs text-admin-muted" for="bulk-template-select">Template for the ticked {tax.label.toLowerCase()}</label>
    <select id="bulk-template-select" name="template" class={`${input} w-56`}>
      <option value="">Default (the taxonomy's, or the term above's)</option>
      {templates.map((tp) => <option value={tp.slug}>{templateLabel({ ...tp, content: true })}</option>)}
    </select>
    <button class="rounded border border-admin-ink/15 bg-white px-3 py-1 text-xs hover:border-admin-accent">Apply</button>
    <span class="text-xs text-admin-muted">Terms under a term with a template share it.</span>
  </form>
)}

{!flat && ordered.length > 0 && (
  <div data-drop-top class="mt-3 hidden rounded border-2 border-dashed border-admin-accent/50 px-4 py-2 text-xs text-admin-muted">Drop here to move to the top level</div>
)}

<table class="mt-3 w-full border-collapse overflow-hidden rounded bg-white text-sm shadow-[0_0_0_1px_rgba(26,26,46,0.08)]">
  <thead class="bg-admin-soft text-left text-xs tracking-wider text-admin-muted uppercase">
    <tr>
      {pages && <th class="w-8 py-2.5 pl-4"><span class="sr-only">Tick</span></th>}
      <th class="px-4 py-2.5 font-semibold">Name</th>
      <th class="px-4 py-2.5 font-semibold">Address</th>
      {pages && <th class="px-4 py-2.5 font-semibold">Template</th>}
      <th class="px-4 py-2.5 font-semibold">Used on</th>
      <th class="px-4 py-2.5"><span class="sr-only">Actions</span></th>
    </tr>
  </thead>
  <tbody>
    {ordered.map((t) => {
      const form = `term-${t.id}`;
      const blocked = under(t.id);
      return (
        <tr class="border-t border-admin-ink/5 align-middle hover:bg-admin-bg" data-term={t.id} data-parent={ids.has(t.parent) ? t.parent : 0} data-blocked={[...blocked].join(',')}>
          {pages && <td class="py-2 pl-4"><input type="checkbox" name="ids" value={t.id} form="bulk-template" aria-label={`Tick ${decode(t.name)}`} /></td>}
          <td class="px-4 py-2">
            <form id={form} method="post" action="/api/admin/terms">
              <input type="hidden" name="taxonomy" value={tax.name} />
              <input type="hidden" name="action" value="update" />
              <input type="hidden" name="id" value={t.id} />
            </form>
            <span style={`padding-left:${t.depth * 1.25}rem`} class="inline-flex items-center gap-1">
              {(
                <span class="relative">
                  <span role="button" tabindex="0" draggable="true" data-handle={t.id} aria-label={`Move ${decode(t.name)}`} aria-expanded="false" title={flat ? 'Drag above or below another tag to reorder, or press Enter for Move up and down' : 'Drag onto the top or bottom edge of a term to go beside it, onto its middle to go under it; or press Enter to choose'} class="inline-block cursor-grab rounded px-1 py-1 text-admin-muted select-none hover:bg-admin-ink/5 hover:text-admin-ink">
                    <svg width="10" height="16" viewBox="0 0 10 16" aria-hidden="true" fill="currentColor"><circle cx="2.5" cy="3" r="1.5" /><circle cx="7.5" cy="3" r="1.5" /><circle cx="2.5" cy="8" r="1.5" /><circle cx="7.5" cy="8" r="1.5" /><circle cx="2.5" cy="13" r="1.5" /><circle cx="7.5" cy="13" r="1.5" /></svg>
                  </span>
                  <div data-move-menu={t.id} hidden class="absolute top-full left-0 z-10 mt-1 w-64 rounded bg-white p-2 shadow-lg ring-1 ring-admin-ink/10">
                    {(() => {
                      const level = ordered.filter((o) => o.parent === t.parent || (!ids.has(o.parent) && !ids.has(t.parent)));
                      const i = level.findIndex((o) => o.id === t.id);
                      const prev = level[i - 1];
                      const next = level[i + 1];
                      return (
                        <div class="flex gap-2">
                          {prev && <button type="button" data-move-to={`before:${prev.id}`} class="rounded border border-admin-ink/15 px-2 py-1 text-xs hover:border-admin-accent">Move up</button>}
                          {next && <button type="button" data-move-to={`after:${next.id}`} class="rounded border border-admin-ink/15 px-2 py-1 text-xs hover:border-admin-accent">Move down</button>}
                        </div>
                      );
                    })()}
                    {!flat && (
                      <label class="mt-2 block text-xs text-admin-muted">Move under
                        <select data-move-under class={`${input} mt-1 block w-full`}>
                          <option value="" selected={!t.parent}>(top level)</option>
                          {ordered.filter((o) => !blocked.has(o.id)).map((o) => <option value={o.id} selected={o.id === t.parent}>{'\u00a0\u00a0'.repeat(o.depth)}{decode(o.name)}</option>)}
                        </select>
                      </label>
                    )}
                    {!flat && <button type="button" data-move-apply class="mt-2 rounded bg-admin-ink px-3 py-1 text-xs font-semibold text-white">Move</button>}
                  </div>
                </span>
              )}
              <input form={form} name="name" value={decode(t.name)} required aria-label="Name" class={`${input} w-52 border-transparent hover:border-admin-ink/15`} />
            </span>
          </td>
          <td class="px-4 py-2"><input form={form} name="slug" value={t.slug} aria-label="Address" class={`${input} w-40 border-transparent font-mono text-xs hover:border-admin-ink/15`} /></td>
          {pages && (
            <td class="px-4 py-2">
              <select form={form} name="template" aria-label="Template" class={`${input} w-44`}>
                <option value="">Default ({inherited(t.id)})</option>
                {templates.map((tp) => <option value={tp.slug} selected={tp.slug === t.template}>{templateLabel({ ...tp, content: true })}</option>)}
              </select>
            </td>
          )}
          <td class="px-4 py-2 text-admin-muted">{t.count ? `${t.count} ${t.count === 1 ? 'entry' : 'entries'}` : 'Not used'}</td>
          <td class="px-4 py-2 text-right whitespace-nowrap">
            <button form={form} class="text-xs text-admin-ink hover:text-admin-accent">Save</button>
            <button type="button" data-term-details={t.id} class="ml-3 text-xs text-admin-ink hover:text-admin-accent" aria-label={`Details of ${decode(t.name)}: description, featured image, fields, SEO`}>Details</button>
            {pages && <a href={termLink({ taxonomy: tax.name, slug: t.slug })} target="_blank" class="ml-3 text-xs text-admin-muted hover:text-admin-accent">View</a>}
            <form method="post" action="/api/admin/terms" class="ml-3 inline" data-confirm={`Delete "${decode(t.name)}"?${t.count ? ` It is removed from ${t.count} ${t.count === 1 ? 'entry' : 'entries'}.` : ''}${childrenOf(t.id).length ? ' The terms under it move up a level.' : ''}`}>
              <input type="hidden" name="taxonomy" value={tax.name} />
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="id" value={t.id} />
              <button class="text-xs text-[#c4592a] hover:underline">Delete</button>
            </form>
          </td>
        </tr>
      );
    })}
    {!ordered.length && <tr><td colspan="7" class="px-4 py-10 text-center text-admin-muted">No {tax.label.toLowerCase()} yet.{flat ? ' Add one here or in any entry’s settings.' : ''}</td></tr>}
  </tbody>
</table>
<TermDetails client:load taxonomy={tax.name} />
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) => f.addEventListener('submit', (e) => { if (!confirm(f.dataset.confirm!)) e.preventDefault(); }));

  // Moving terms: drag a term's handle onto the top or bottom edge of another term (it goes beside it,
  // in that order), onto its middle (it goes under it) or onto Top level; with the keyboard (or a
  // click), the handle opens a menu: Move up, Move down, Move under.
  const top = document.querySelector<HTMLElement>('[data-drop-top]');
  const taxonomy = document.querySelector<HTMLInputElement>('form:has(input[value="create"]) input[name="taxonomy"]')!.value;
  const flat = taxonomy === 'tag';
  const send = (id: string, fields: Record<string, string>) => {
    const f = document.createElement('form');
    f.method = 'post';
    f.action = '/api/admin/terms';
    for (const [k, v] of Object.entries({ taxonomy, action: 'move', id, ...fields })) {
      const i = document.createElement('input');
      i.type = 'hidden';
      i.name = k;
      i.value = v;
      f.append(i);
    }
    document.body.append(f);
    f.submit();
  };
  let dragged = '';
  const clear = () => document.querySelectorAll('[data-drop-on]').forEach((el) => el.removeAttribute('data-drop-on'));
  const blockedOf = (id: string) => (document.querySelector<HTMLElement>(`tr[data-term="${id}"]`)?.dataset.blocked ?? '').split(',');
  /** Where a drop on a row puts the dragged term: before or after it (its edges), or under it (middle). */
  const zoneOf = (row: HTMLElement, e: DragEvent): 'before' | 'after' | 'into' | null => {
    if (!dragged || row.dataset.term === dragged) return null;
    const r = row.getBoundingClientRect();
    const y = (e.clientY - r.top) / r.height;
    const zone = flat ? (y < 0.5 ? 'before' : 'after') : y < 0.25 ? 'before' : y > 0.75 ? 'after' : 'into';
    const blocked = blockedOf(dragged);
    if (zone === 'into' && blocked.includes(row.dataset.term!)) return null;
    if (zone !== 'into' && blocked.includes(row.dataset.parent!)) return null;
    return zone;
  };
  document.querySelectorAll<HTMLElement>('[data-handle]').forEach((handle) => {
    const id = handle.dataset.handle!;
    const menu = document.querySelector<HTMLElement>(`[data-move-menu="${id}"]`)!;
    handle.addEventListener('dragstart', (e) => {
      dragged = id;
      e.dataTransfer?.setData('text/plain', id);
      if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
      // Changing the page during dragstart cancels the drag in Chrome: show Top level just after.
      if (!flat) setTimeout(() => top?.classList.remove('hidden'), 0);
    });
    handle.addEventListener('dragend', () => {
      dragged = '';
      clear();
      top?.classList.add('hidden');
    });
    const toggle = () => {
      menu.hidden = !menu.hidden;
      handle.setAttribute('aria-expanded', String(!menu.hidden));
      if (!menu.hidden) menu.querySelector<HTMLElement>('button, select')?.focus();
    };
    handle.addEventListener('click', toggle);
    handle.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      toggle();
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      menu.hidden = true;
      handle.setAttribute('aria-expanded', 'false');
      handle.focus();
    });
    menu.querySelectorAll<HTMLButtonElement>('[data-move-to]').forEach((b) =>
      b.addEventListener('click', () => {
        const [where, other] = b.dataset.moveTo!.split(':');
        send(id, { [where]: other });
      }),
    );
    menu.querySelector('[data-move-apply]')?.addEventListener('click', () => send(id, { parent: menu.querySelector<HTMLSelectElement>('[data-move-under]')!.value }));
  });
  document.querySelectorAll<HTMLTableRowElement>('tr[data-term]').forEach((row) => {
    row.addEventListener('dragover', (e) => {
      const zone = zoneOf(row, e);
      if (!zone) return;
      e.preventDefault();
      clear();
      row.setAttribute('data-drop-on', zone);
    });
    row.addEventListener('dragleave', () => row.removeAttribute('data-drop-on'));
    row.addEventListener('drop', (e) => {
      const zone = zoneOf(row, e);
      if (!zone) return;
      e.preventDefault();
      send(dragged, zone === 'into' ? { parent: row.dataset.term! } : { [zone]: row.dataset.term! });
    });
  });
  top?.addEventListener('dragover', (e) => {
    if (!dragged) return;
    e.preventDefault();
    top.setAttribute('data-drop-on', 'into');
  });
  top?.addEventListener('dragleave', () => top.removeAttribute('data-drop-on'));
  top?.addEventListener('drop', (e) => {
    e.preventDefault();
    if (dragged) send(dragged, { parent: '' });
  });
</script>
<style>
  [data-drop-on='into'] {
    outline: 2px solid var(--color-admin-accent);
    outline-offset: -2px;
    background: rgba(184, 115, 51, 0.08);
  }
  /* Beside a term: a line where it will go. */
  tr[data-drop-on='before'] > td {
    box-shadow: inset 0 3px 0 var(--color-admin-accent);
  }
  tr[data-drop-on='after'] > td {
    box-shadow: inset 0 -3px 0 var(--color-admin-accent);
  }
</style>
