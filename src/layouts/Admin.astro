---
import { SITE_TZ, site } from '../lib/site';
import AdminTheme from './AdminTheme.astro';
import { loadAdminTheme } from '../lib/admin-theme';
import { siteDb } from '../lib/supabase';
import { memberSettings } from '../lib/members/config';
// Admin chrome. Tailwind only; the public site's CSS never loads here.
import '../styles/tailwind.css';
import '../styles/admin.css';

interface Props {
  title: string;
  wide?: boolean;
}
const { title, wide = false } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const isAdmin = user?.role === 'admin';
const theme = await loadAdminTheme(Astro.locals.db ?? siteDb());
// Members, while it is on (Settings > Members).
const membersOn = isAdmin && memberSettings((await (Astro.locals.db ?? siteDb()).from('settings').select('value').eq('key', 'site').maybeSingle()).data?.value).enabled;
const nav = [
  { href: '/admin/', label: 'Content' },
  { href: '/admin/templates/', label: 'Templates' },
  { href: '/admin/media/', label: 'Media' },
  { href: '/admin/forms/', label: 'Forms' },
  { href: '/admin/submissions/', label: 'Submissions' },
  { href: '/admin/tickets/', label: 'Tickets' },
  { href: '/admin/settings/', label: 'Settings', admin: true },
  { href: '/admin/users/', label: 'Users', admin: true },
  ...(membersOn ? [{ href: '/admin/members/', label: 'Members', admin: true }] : []),
].filter((n) => !n.admin || isAdmin);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ siteTz: SITE_TZ }}>window.__siteTz = siteTz;</script>
    <title>{title} · {site.name} admin</title>
    <AdminTheme theme={theme} />
  </head>
  <body class="min-h-screen bg-admin-bg font-admin text-admin-ink antialiased">
    {
      user && (
        <header class="border-b border-admin-ink/10 bg-admin-bar text-admin-on-bar">
          <div class="mx-auto flex h-14 max-w-[1280px] items-center gap-6 px-6">
            {/* The logo from Settings > Admin, else (or beside it) the site name; the settings screen previews changes here. */}
            <a href="/admin/" id="admin-brand" class="flex shrink-0 items-center gap-2.5 whitespace-nowrap text-lg font-semibold">
              {theme?.logo_url && <img src={theme.logo_url} alt={theme.logo_name ? '' : site.name} class="block h-8 w-auto max-w-[120px] object-contain sm:max-w-[180px]" />}
              {(!theme?.logo_url || theme.logo_name) && <span class:list={[theme?.logo_url && 'max-sm:hidden']}>{site.name}</span>}
            </a>
            {/* One line: items never wrap; when space runs out the menu scrolls sideways. */}
            <nav class="admin-nav -my-2 flex min-w-0 flex-1 gap-1 overflow-x-auto py-2 text-sm" aria-label="Admin">
              {nav.map((n) => (
                <a href={n.href} class:list={['shrink-0 whitespace-nowrap rounded px-3 py-1.5 transition-colors', (n.href === '/admin/' ? path === '/admin/' || path.startsWith('/admin/content') || path.startsWith('/admin/compose') : path.startsWith(n.href)) ? 'bg-admin-on-bar/15' : 'text-admin-on-bar/65 hover:bg-admin-on-bar/10 hover:text-admin-on-bar']}>
                  {n.label}
                </a>
              ))}
            </nav>
            <div class="flex shrink-0 items-center gap-4 text-sm text-admin-on-bar/65">
              <a href="/" target="_blank" class="whitespace-nowrap hover:text-admin-on-bar">View site</a>
              <details class="relative">
                <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full py-1 pr-2 pl-1 hover:bg-admin-on-bar/10 [&::-webkit-details-marker]:hidden" aria-label="Account">
                  <span class="flex h-7 w-7 items-center justify-center rounded-full bg-admin-accent text-xs font-semibold text-white uppercase">{(user.name || user.email).slice(0, 1)}</span>
                  <span class="max-w-32 truncate text-admin-on-bar">{user.name || user.email.split('@')[0]}</span>
                </summary>
                <div class="absolute right-0 z-50 mt-2 w-64 rounded-lg border border-admin-ink/10 bg-white p-3 text-admin-muted shadow-lg">
                  <div class="truncate font-medium text-admin-ink">{user.email}</div>
                  <div class="mb-3 text-xs">{user.role === 'admin' ? 'Admin' : 'Editor'}</div>
                  <form method="post" action="/api/auth/logout">
                    <button class="w-full rounded border border-admin-ink/15 px-3 py-1.5 text-left hover:border-admin-accent hover:text-admin-accent">Sign out</button>
                  </form>
                </div>
              </details>
            </div>
          </div>
        </header>
      )
    }
    <main class:list={[wide ? '' : 'mx-auto max-w-[1280px] px-6 py-8']}>
      {Astro.url.searchParams.get('error') === 'admins-only' && <p class="mb-4 rounded bg-[#c4592a]/10 px-3 py-2 text-sm text-[#c4592a]">That section is for admins.</p>}
      <slot />
    </main>
  </body>
</html>
