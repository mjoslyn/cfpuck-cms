---
// The admin colors chosen under Settings > Appearance (src/lib/admin-theme.ts), and what every admin page
// shares: a focused number field ignores the scroll wheel, which would otherwise change its value (from
// empty, down to its minimum: a ticket's capacity of 0, sold out) while the page scrolls.
import { adminThemeCss, loadAdminTheme, type AdminTheme } from '../lib/admin-theme';
import { siteDb } from '../lib/db/site';

interface Props {
  /** The saved theme, when the page has loaded it already. */
  theme?: AdminTheme;
}
const css = adminThemeCss(Astro.props.theme ?? (await loadAdminTheme(Astro.locals.db ?? siteDb())));
---
{css && <style is:inline id="admin-theme" set:html={css} />}
<script is:inline>
  addEventListener('wheel', (e) => {
    const el = e.target;
    if (el instanceof HTMLInputElement && el.type === 'number' && el === document.activeElement) el.blur();
  }, { passive: true, capture: true });
</script>
