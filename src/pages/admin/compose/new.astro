---
// The admin bar's Compose menu, for what isn't an entry: a form, a campaign (while Mailing is on), a
// template, a template part or a pattern. Laid out as Compose for a page (/admin/compose/): describe it
// (src/admin/ComposeStart.tsx), and it is made and opens in its own editor, where Compose writes it.
import Admin from '../../../layouts/Admin.astro';
import ComposeStart, { type StartKind } from '../../../admin/ComposeStart';
import { env } from '../../../lib/compose/claude';
import { typeDef, SITE_TZ } from '../../../lib/site';
import { mailingOn } from '../../../lib/mailing/config';

const LABELS: Record<StartKind, { title: string; lead: string; recent: string }> = {
  form: { title: 'Compose a form', lead: "Describe the form and Claude writes it in the form builder: its questions, its thank-you message and its emails. Check them there, then Save.", recent: 'Your forms' },
  campaign: { title: 'Compose a campaign', lead: 'Describe the email and Claude writes it as a draft campaign in the site\'s email style. Choose its lists, check it, then Save and send.', recent: 'Recent campaigns' },
  template: { title: 'Compose a template', lead: 'Describe the layout and Claude builds it in the editor. Every page using it shares it.', recent: 'Templates' },
  part: { title: 'Compose a template part', lead: 'Describe the header, footer or other shared section and Claude builds it in the editor.', recent: 'Template parts' },
  pattern: { title: 'Compose a pattern', lead: 'Describe the group of blocks and Claude builds it in the editor, ready to insert on any page.', recent: 'Patterns' },
};
const kind = (Astro.url.searchParams.get('kind') ?? '') as StartKind;
const db = Astro.locals.db;
const { data: siteRow } = await db.from('settings').select('value').eq('key', 'site').maybeSingle();
if (!LABELS[kind] || (kind === 'campaign' && !mailingOn(siteRow?.value))) return Astro.redirect('/admin/compose/');
const l = LABELS[kind];
const configured = !!env('ANTHROPIC_API_KEY');
// The latest of the kind beside it, as Compose for a page lists its conversations.
const recent: { href: string; title: string; when: string }[] =
  kind === 'form'
    ? ((await db.from('forms').select('id, title, updated_at').order('updated_at', { ascending: false }).limit(12)).data ?? []).map((f) => ({ href: `/admin/forms/${f.id}/`, title: f.title, when: f.updated_at }))
    : kind === 'campaign'
      ? ((await db.from('campaigns').select('id, name, updated_at').is('digest_id', null).order('updated_at', { ascending: false }).limit(12)).data ?? []).map((c) => ({ href: `/admin/mailing-lists/campaigns/${c.id}/`, title: c.name, when: c.updated_at }))
      : ((await db.from('templates').select('slug, title, updated_at').eq('kind', kind).is('trashed_at', null).order('updated_at', { ascending: false }).limit(12)).data ?? []).map((t) => ({ href: `/admin/templates/${kind}/${t.slug}/`, title: t.title || t.slug, when: t.updated_at }));
const when = (s: string) => new Date(s).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: SITE_TZ });
---
<Admin title={l.title}>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px]">
    <div>
      <h1 class="text-3xl font-normal">{l.title}</h1>
      <p class="mt-1 mb-4 text-sm text-admin-muted">{l.lead}</p>
      {!configured && <p class="mb-4 rounded bg-admin-soft px-3 py-2 text-sm text-admin-ink">Claude isn't connected yet: an admin adds its key under <a class="underline" href="/admin/settings/connections/">Settings &gt; Connections</a>.</p>}
      <div class="h-[70vh] min-h-[480px] overflow-hidden rounded-lg border border-admin-ink/10 bg-white">
        <ComposeStart client:load kind={kind} canPage={!!typeDef('page')} />
      </div>
    </div>
    <aside>
      <h2 class="mb-2 text-xs font-semibold tracking-wider text-admin-muted uppercase">{l.recent}</h2>
      {recent.length ? (
        <ul class="m-0 list-none space-y-2 p-0 text-sm">
          {recent.map((r) => (
            <li class="rounded border border-admin-ink/10 bg-white p-2">
              <a href={r.href} class="font-medium hover:text-admin-accent">{r.title || '(untitled)'}</a>
              <div class="text-xs text-admin-muted">Changed {when(r.when)}</div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-admin-muted">None yet.</p>
      )}
    </aside>
  </div>
</Admin>
