---
import Admin from '../../../layouts/Admin.astro';
import { SITE_TZ } from '../../../lib/site';
import Composer from '../../../admin/Composer';
import { env } from '../../../lib/compose/claude';
const configured = !!env('ANTHROPIC_API_KEY');
// Recent conversations, to pick up where they left off (in the page editor).
const { data: recent } = await Astro.locals.db
  .from('compose_sessions')
  .select('id, entry_id, updated_at, turns, entries(title, type, status)')
  .not('entry_id', 'is', null)
  .order('updated_at', { ascending: false })
  .limit(12);
const when = (s: string) => new Date(s).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: SITE_TZ });
const lastAsk = (turns: any[]) => [...(turns ?? [])].reverse().find((t) => t.role === 'user' && t.text)?.text ?? '';
---
<Admin title="Compose">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px]">
    <div>
      <h1 class="text-3xl font-normal">Compose a page</h1>
      <p class="mt-1 mb-4 text-sm text-admin-muted">
        Describe the page and add what it should draw on. Claude builds a draft in the site's style; keep talking to it here or in the page editor to change it.
      </p>
      {!configured && <p class="mb-4 rounded bg-admin-soft px-3 py-2 text-sm text-admin-ink">Claude isn't connected yet: an admin adds its key under <a class="underline" href="/admin/settings/connections/">Settings &gt; Connections</a>.</p>}
      <div class="h-[70vh] min-h-[480px] overflow-hidden rounded-lg border border-admin-ink/10 bg-white">
        <Composer client:only="react" />
      </div>
    </div>
    <aside>
      <h2 class="mb-2 text-xs font-semibold tracking-wider text-admin-muted uppercase">Continue a conversation</h2>
      {recent?.length ? (
        <ul class="space-y-2 text-sm">
          {recent.map((r: any) => (
            <li class="rounded border border-admin-ink/10 bg-white p-2">
              <a href={`/admin/edit/${r.entry_id}/?compose=1`} class="font-medium hover:text-admin-accent">{r.entries?.title || '(untitled)'}</a>
              <div class="text-xs text-admin-muted">{r.entries?.type} · {r.entries?.status} · {when(r.updated_at)}</div>
              {lastAsk(r.turns) && <p class="mt-1 line-clamp-2 text-xs text-admin-muted">“{lastAsk(r.turns)}”</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-admin-muted">None yet.</p>
      )}
    </aside>
  </div>
</Admin>
