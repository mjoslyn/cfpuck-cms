---
import AdminTheme from '../../../../layouts/AdminTheme.astro';
import { SITE_TZ, appliedTaxonomySettings, site } from '../../../../lib/site';
import '../../../../styles/tailwind.css';
import '../../../../styles/admin.css';
import Editor from '../../../../puck/Editor';

const kind = (['part', 'pattern'].includes(Astro.params.kind!) ? Astro.params.kind : 'template') as 'template' | 'part' | 'pattern';
const slug = Astro.params.slug!;
// An address it had before it was renamed opens it at its address now.
const { data: here } = await Astro.locals.db.from('templates').select('id, trashed_at').eq('kind', kind).eq('slug', slug).maybeSingle();
// One in the trash is restored from the list first.
if (here?.trashed_at) return Astro.redirect('/admin/templates/#trash');
if (!here) {
  const { data: all } = await Astro.locals.db.from('templates').select('slug, former_slugs').eq('kind', kind);
  const moved = (all ?? []).find((t) => ((t.former_slugs as string[] | null) ?? []).includes(slug));
  if (moved) return Astro.redirect(`/admin/templates/${kind}/${moved.slug}/`);
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ siteTz: SITE_TZ, siteTaxonomies: appliedTaxonomySettings() }}>window.__siteTz = siteTz; window.__siteTaxonomies = siteTaxonomies;</script>
    <AdminTheme />
    <title>{slug} · {site.name} admin</title>
  </head>
  <body class="h-screen overflow-hidden font-admin">
    <a href="/admin/templates/" class="fixed bottom-3 left-3 z-[2000] rounded bg-white px-3 py-1.5 text-xs text-admin-muted shadow hover:text-admin-accent">Back to templates</a>
    <Editor client:only="react" template={{ kind, slug }} />
  </body>
</html>
