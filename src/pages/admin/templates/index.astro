---
import Admin from '../../../layouts/Admin.astro';
import MakePage from '../../../admin/MakePage';
import RenameTemplate from '../../../admin/RenameTemplate';
import { eventsOn } from '../../../lib/events/on';
const { data: siteRow } = await Astro.locals.db.from('settings').select('value').eq('key', 'site').maybeSingle();
const events = eventsOn(siteRow?.value as Record<string, any> | undefined);
const { data, error } = await Astro.locals.db.from('templates').select('kind, slug, title, updated_at, linked:content->root->props->linked').in('kind', ['template', 'part', 'pattern']).order('kind').order('slug');
if (error) throw error;
const groups = [
  { kind: 'part', label: 'Template parts', note: 'Shared sections such as the header and footer.' },
  { kind: 'template', label: 'Templates', note: 'Page layouts chosen by the template hierarchy or per page.' },
  { kind: 'pattern', label: 'Patterns', note: 'Reusable groups of blocks. Insert one from the Patterns tab in the editor; the page gets its own copy to edit.' },
];
---
<Admin title="Templates">
  <h1 class="text-3xl font-normal">Templates</h1>
  {groups.map((g) => (
    <section class="mt-8">
      <h2 class="text-sm font-semibold tracking-wider text-admin-muted uppercase">{g.label}</h2>
      <p class="text-sm text-admin-muted">{g.note}</p>
      <ul class="mt-3 grid list-none grid-cols-3 gap-3 p-0">
        {(data ?? []).filter((t) => t.kind === g.kind).map((t) => (
          <li class="relative">
            <a href={`/admin/templates/${t.kind}/${t.slug}/`} class="block h-full rounded bg-white p-4 pb-10 shadow-[0_0_0_1px_rgba(26,26,46,0.08)] hover:shadow-[0_0_0_2px_var(--color-admin-accent)]">
              <span class="font-medium">{t.title || t.slug}</span>
              {(t as any).linked === true && <span class="ml-1.5 rounded bg-admin-accent/15 px-1.5 py-0.5 text-[10px] font-semibold tracking-wide text-admin-accent-dark uppercase">Linked</span>}
              <span class="block text-xs text-admin-muted">{t.slug}</span>
            </a>
            <div class="absolute bottom-3 left-4 flex items-center gap-4">
              <form method="post" action="/api/admin/templates">
                <input type="hidden" name="kind" value={t.kind} />
                <input type="hidden" name="slug" value={t.slug} />
                <button class="text-xs text-admin-muted hover:text-admin-accent" aria-label={`Duplicate ${t.title || t.slug}`}>Duplicate</button>
              </form>
              <RenameTemplate client:idle kind={t.kind} slug={t.slug} title={t.title || t.slug} />
              <MakePage client:idle kind={t.kind} slug={t.slug} title={t.title || t.slug} events={events} />
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Admin>
