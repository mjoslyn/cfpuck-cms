---
import AdminTheme from '../../../layouts/AdminTheme.astro';
import '../../../styles/tailwind.css';
import '../../../styles/admin.css';
import Editor from '../../../puck/Editor';
import RecordEditor from '../../../puck/RecordEditor';
import Admin from '../../../layouts/Admin.astro';
import { RECORD_TYPES, SITE_TZ, appliedTypeSettings, site, typeLabel } from '../../../lib/site';

const id = Number(Astro.params.id);
if (!id) return Astro.redirect('/admin/');
const { data: row } = await Astro.locals.db.from('entries').select('type, title').eq('id', id).maybeSingle();
if (!row) return Astro.redirect('/admin/');
const record = RECORD_TYPES.has(row.type);
const singular = typeLabel(row.type);
---
{record ? (
  <Admin title={`Edit ${singular}`}>
    <a href={`/admin/?type=${row.type}`} class="text-xs text-admin-muted hover:text-admin-accent">&larr; All {singular.toLowerCase()}s</a>
    <h1 class="mt-2 mb-6 text-3xl font-normal">{row.title || `New ${singular.toLowerCase()}`}</h1>
    <RecordEditor client:only="react" entryId={id} singular={singular} />
  </Admin>
) : (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta name="robots" content="noindex" />
      <script is:inline define:vars={{ siteTz: SITE_TZ, siteTypes: appliedTypeSettings() }}>window.__siteTz = siteTz; window.__siteTypes = siteTypes;</script>
      <AdminTheme />
      <title>Edit · {site.name} admin</title>
    </head>
    <body class="h-screen overflow-hidden font-admin">
      <Editor client:only="react" entryId={id} admin={Astro.locals.user.role === 'admin'} />
    </body>
  </html>
)}
