---
// Set a password: where invitation and password-reset emails land, with the session in the URL fragment
// (the script below hands it to /api/auth/session). A link with ?code= (one asked for before reset links were sent that way)
// is exchanged here, which only works in the browser that asked for it; someone already signed in
// carries on without an error. Then the form sets the password (/api/auth/password).
import Admin from '../../layouts/Admin.astro';
import { serverClient } from '../../lib/supabase';

const code = Astro.url.searchParams.get('code');
if (code) {
  const db = serverClient(Astro.request, Astro.cookies);
  const { error } = await db.auth.exchangeCodeForSession(code);
  const failed = error && !(await db.auth.getUser()).data.user;
  return Astro.redirect(failed ? `/admin/set-password/?error=${encodeURIComponent('That link has expired, was already used, or was opened in a different browser. Ask for a new one.')}` : '/admin/set-password/');
}
const error = Astro.url.searchParams.get('error');
const { data: { user } } = await serverClient(Astro.request, Astro.cookies).auth.getUser();
---
<Admin title="Set your password">
  <div class="mx-auto mt-24 max-w-sm">
    <h1 class="text-3xl font-normal">Set your password</h1>
    <p class="mt-2 text-sm text-admin-muted" id="who">{user ? `For ${user.email}.` : 'Checking your link…'}</p>
    {error && <p class="mt-6 rounded border border-[#c4592a]/30 bg-[#c4592a]/5 px-3 py-2 text-sm text-[#c4592a]">{error}</p>}
    <form method="post" action="/api/auth/password" class="mt-6 space-y-4" id="form" hidden={!user}>
      <label class="block text-sm">
        <span class="mb-1 block font-medium">New password</span>
        <input name="password" type="password" required minlength="10" autocomplete="new-password" class="w-full rounded border border-admin-ink/20 bg-white px-3 py-2 outline-none focus:border-admin-accent" />
      </label>
      <label class="block text-sm">
        <span class="mb-1 block font-medium">Repeat it</span>
        <input name="confirm" type="password" required minlength="10" autocomplete="new-password" class="w-full rounded border border-admin-ink/20 bg-white px-3 py-2 outline-none focus:border-admin-accent" />
      </label>
      <button class="w-full rounded-sm bg-admin-ink px-4 py-2.5 text-sm font-semibold tracking-wider text-white uppercase hover:bg-admin-accent">Save password</button>
    </form>
    <p class="mt-6 text-sm" id="expired" hidden>{!error && <span class="text-admin-muted">This link has expired or was already used.</span>} <a href="/admin/login/?forgot=1" class="underline hover:text-admin-accent">Send a new one</a></p>
  </div>
</Admin>
<script>
  // Invitation and reset links put the session in the fragment: the site's server stores it (as the shared
  // session cookie, /api/auth/session), then the page reloads signed in. The fragment's own error (a link
  // already used or expired) is shown as it is.
  const hash = new URLSearchParams(location.hash.slice(1));
  const form = document.getElementById('form')!;
  const access = hash.get('access_token');
  const refresh = hash.get('refresh_token');
  if (access && refresh) {
    history.replaceState(null, '', location.pathname + location.search);
    fetch('/api/auth/session', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ access_token: access, refresh_token: refresh }) })
      .then(async (r) => location.replace(r.ok ? '/admin/set-password/' : `/admin/set-password/?error=${encodeURIComponent((await r.text()) || 'That link has expired or was already used. Ask for a new one.')}`))
      .catch(() => location.replace(`/admin/set-password/?error=${encodeURIComponent('That link could not be checked. Try it again.')}`));
  } else if (hash.get('error_description')) {
    location.replace(`/admin/set-password/?error=${encodeURIComponent(hash.get('error_description')!)}`);
  } else if (form.hidden) {
    // No session: the link was expired, used, or opened without one.
    document.getElementById('who')!.hidden = true;
    document.getElementById('expired')!.hidden = false;
  }
</script>
