{
  "name": "supapuck-cms",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/gen-redirects.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "start": "wrangler d1 migrations apply DB --local && astro dev",
    "check": "tsc --noEmit -p .",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:remote": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/react": "^7.0.0",
    "@puckeditor/core": "^0.23.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.13",
    "html-react-parser": "^6.1.8",
    "image-size": "^2.0.4",
    "mammoth": "^1.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spark-md5": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "worker-mailer": "^1.3.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/spark-md5": "^3.0.5",
    "node-html-parser": "^9.0.4",
    "parse5": "^8.0.1",
    "pg": "^8.23.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "wrangler": "^4.152.0"
  }
}
